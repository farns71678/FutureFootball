// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  password    String // should be salted and encrypted
  name        String
  picture     Bytes?
  createdAt   DateTime      @default(now())
  picks       UserPicks?
  groupsOwned Group[]
  memberships GroupMember[]
}

model UserPicks {
  id        Int               @id @default(autoincrement())
  user      User              @relation(fields: [userId], references: [id])
  userId    Int               @unique
  picks     UserLeaguePicks[]
  season    Int // server needs to clear picks if from a previous season
  finalized Boolean
}

model Group {
  id        Int           @id @default(autoincrement())
  owner     User          @relation(fields: [ownerId], references: [id])
  ownerId   Int
  name      String
  picture   Bytes?
  createdAt DateTime      @default(now())
  members   GroupMember[]
}

model GroupMember {
  id          Int                 @id @default(autoincrement())
  group       Group               @relation(fields: [groupId], references: [id])
  groupId     Int
  user        User                @relation(fields: [userId], references: [id])
  userId      Int
  memberPicks MemberLeaguePicks[]
  season      Int // server needs to clear picks if from a previous season

  @@unique([groupId, userId])
}

model UserLeaguePicks {
  userPicks UserPicks @relation(fields: [userId], references: [id])
  userId    Int
  league    League
  teams     Int[]

  @@id([userId, league])
}

model MemberLeaguePicks {
  member   GroupMember @relation(fields: [memberId], references: [id])
  memberId Int
  league   League
  teams    Int[]

  @@id([memberId, league])
}

enum League {
  NFL
  NCAA
}
